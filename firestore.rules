rules_version = '2';

/* ------------------------------------------------------------------ */
/*  BCBHS Alumni Portal — Firestore security rules.                    */
/*                                                                     */
/*  Model:                                                             */
/*  - users/{uid}: member profiles. Logged-out guests may read only    */
/*    approved profiles flagged guestVisible (the admin-picked public  */
/*    directory preview); signed-in members may read all approved      */
/*    profiles; owners and staff can read any profile.                 */
/*  - users_private/{uid}: phone numbers ONLY. Readable by the owner   */
/*    and staff (admin / super_admin); writable by the owner only.     */
/*    The `phone` field is banned from `users` docs by validation.     */
/*  - Only staff with the `approve_members` permission (or the super   */
/*    admin) may change status / role / permissions / memberId.        */
/*  - The super admin (role == "super_admin") has full write access    */
/*    and may assign any role (member / editor / admin / super_admin). */
/*  - Editors (role == "editor") carry a fixed content bundle:         */
/*    manage_events, manage_gallery, post_announcements,               */
/*    manage_committee.                                                */
/*                                                                     */
/*  NOTE: the client additionally hides phone numbers unless the       */
/*  viewer is the owner or has the `view_member_data` permission —     */
/*  defence in depth on top of the `users_private` rules above.        */
/* ------------------------------------------------------------------ */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return signedIn() && me().role == 'super_admin';
    }

    function isAdmin() {
      return signedIn() && (me().role == 'admin' || me().role == 'super_admin');
    }

    function isEditor() {
      return signedIn() && me().role == 'editor';
    }

    function editorPerms() {
      return ['manage_events', 'manage_gallery', 'post_announcements', 'manage_committee'];
    }

    function can(perm) {
      return isSuperAdmin()
        || (signedIn() && me().role == 'admin' && perm in me().permissions)
        || (isEditor() && perm in editorPerms())
        /* A customized editor's own toggled list governs, exactly as
           in the app (permissionsCustom set by the super admin). */
        || (isEditor() && me().get('permissionsCustom', false) == true && perm in me().permissions);
    }

    function onlyStatusFieldsChanged() {
      // Approvals may touch status + memberId only — never role/permissions.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'memberId']);
    }

    function profileEditableFields() {
      return ['name', 'batch', 'roll', 'district', 'country', 'isAbroad',
              'department', 'dob', 'profession', 'company', 'photoURL', 'bloodGroup', 'isDonor', 'whatsapp'];
    }

    function onlyPositionChanged() {
      // Official positions are assigned by staff only — never by the member.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['position']);
    }

    function onlyGuestVisibleChanged() {
      // The guest-directory preview flag is toggled by staff only.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestVisible']);
    }

    function onlyProfileFieldsChanged() {
      // Members editing their own profile: safe fields only.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileEditableFields());
    }

    function whatsappValid() {
      return !('whatsapp' in request.resource.data)
        || (request.resource.data.whatsapp is string
            && request.resource.data.whatsapp.size() <= 20);
    }

    match /users/{userId} {
      // Reads: the admin-picked guest preview (approved + guestVisible) is
      // public; approved profiles are readable by any signed-in member;
      // owners and admins can always read their own / any profile.
      allow read: if (resource.data.status == 'approved' && resource.data.guestVisible == true)
        || (signedIn() && (
          resource.data.status == 'approved' ||
          request.auth.uid == userId ||
          isAdmin()
        ));

      // Registration: a signed-in user creates ONLY their own doc, always as
      // a pending plain member. Phone numbers may NEVER live here — they
      // belong in `users_private/{uid}`.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'member'
        && !('phone' in request.resource.data)
        && whatsappValid()
        && request.resource.data.keys().hasAll(['name', 'batch', 'email', 'district', 'department', 'dob', 'status', 'role', 'permissions', 'createdAt',
          'bloodGroup', 'profession', 'company', 'photoURL', 'whatsapp', 'isDonor', 'isAbroad', 'country'])
        // Every registration field is mandatory (owner's rule, 2026-10-23):
        // the form collects them all, and a create that arrives with any
        // of them empty is refused here too, not just in the UI.
        && request.resource.data.bloodGroup is string && request.resource.data.bloodGroup.size() > 0
        && request.resource.data.profession is string && request.resource.data.profession.size() > 0
        && request.resource.data.company is string && request.resource.data.company.size() > 0
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() > 0
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() > 0
        && (!request.resource.data.isAbroad
            || (request.resource.data.country is string && request.resource.data.country.size() > 0));

      // Approvals & bans: the approval permission covers the whole
      // member lifecycle, approve, reject, ban and unban all flip the
      // same status field (+memberId on approval).
      allow update: if can('approve_members') && onlyStatusFieldsChanged() && !('phone' in request.resource.data.diff(resource.data).affectedKeys());

      // Positions: staff with the approval permission may assign / clear a
      // member's official position after manual verification.
      allow update: if can('approve_members') && onlyPositionChanged() && !('phone' in request.resource.data.diff(resource.data).affectedKeys());

      // Guest preview: staff with the approval permission may toggle which
      // approved members appear in the public (logged-out) directory.
      allow update: if can('approve_members') && onlyGuestVisibleChanged() && !('phone' in request.resource.data.diff(resource.data).affectedKeys());

      // Self-service: a member may edit their own profile fields only.
      allow update: if signedIn()
        && request.auth.uid == userId
        && onlyProfileFieldsChanged()
        && !('phone' in request.resource.data.diff(resource.data).affectedKeys())
        && whatsappValid();

      // Roles & permissions: super admin only.
      allow update: if isSuperAdmin() && !('phone' in request.resource.data.diff(resource.data).affectedKeys());

      allow delete: if isSuperAdmin();
    }

    match /users_private/{userId} {
      // Phone numbers: readable by the owner and staff, writable by the
      // owner only (super admin may delete).
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['phone'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20;
      allow delete: if isSuperAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if can('manage_events');
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow write: if can('manage_gallery');
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if can('post_announcements');
    }

    match /committee/{seatId} {
      allow read: if true;
      allow write: if can('manage_committee');
    }

    match /requests/{requestId} {
      // Urgent blood requests: any signed-in member may create and read
      // them (so donors can respond); only the super admin resolves.
      allow create: if signedIn();
      allow read: if signedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /polls/{pollId} {
      // Community polls: members read; content staff create / manage.
      allow read: if signedIn();
      allow write: if can('post_announcements');
    }

    match /pollVotes/{voteId} {
      // One vote per member per poll — the doc id is `${pollId}_${uid}`
      // and a member may only write their own vote.
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && voteId == request.resource.data.pollId + '_' + request.auth.uid;
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /stories/{storyId} {
      // Hall of Fame: public to read; content staff manage.
      allow read: if true;
      allow write: if can('post_announcements');
    }

    match /businesses/{businessId} {
      // Business Directory: public to read; members list their OWN
      // business; the owner or staff may edit / remove it.
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /wallPhotos/{photoId} {
      // Memory Wall: public to read; ONLY the super admin curates it.
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /mentors/{mentorId} {
      // Mentorship: members read; a member lists THEMSELVES as mentor;
      // the owner or staff may remove a listing.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.memberId == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.memberId == request.auth.uid || isAdmin());
    }

    match /fundDonors/{donorId} {
      // Fund honour roll: public to read; content staff manage.
      allow read: if true;
      allow write: if can('post_announcements');
    }

    match /batchLinks/{batch} {
      // Per-batch WhatsApp group links: members read. The super admin
      // sets any batch; a Batch Rep sets only their OWN batch's link
      // (owner's rule, 2026-10-23, so reps never wait on the super admin).
      allow read: if signedIn();
      allow write: if isSuperAdmin()
        || (signedIn()
          && me().get('role', '') == 'admin'
          && me().get('status', '') == 'approved'
          && me().get('batch', '') == batch);
    }

    function jobValid() {
      // A job circular must carry sane core fields and a contact number.
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.company is string
        && request.resource.data.company.size() > 0
        && request.resource.data.company.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 5000
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 8
        && request.resource.data.whatsapp.size() <= 20
        && request.resource.data.postedBy is string;
    }

    match /jobs/{jobId} {
      // Job Board: visible ONLY to registered (signed-in) members.
      allow read: if signedIn();

      // Any registered member may post a job circular; the post must be
      // attributed to the author's own uid.
      allow create: if signedIn()
        && request.resource.data.postedBy == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'company', 'location', 'jobType', 'description', 'whatsapp', 'postedBy', 'posterName', 'posterBatch', 'createdAt'])
        && jobValid();

      // The author may edit their own post; staff may moderate any post.
      // Ownership (postedBy) can never change hands.
      allow update: if signedIn()
        && (resource.data.postedBy == request.auth.uid || isAdmin())
        && request.resource.data.postedBy == resource.data.postedBy
        && jobValid();

      // The author or staff may remove a post.
      allow delete: if signedIn()
        && (resource.data.postedBy == request.auth.uid || isAdmin());
    }

    match /site/{docId} {
      // Public site content (About page) — readable by all, writable by super admin only.
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /verify/{memberId} {
      // Public ID-card verification registry. Holds ONLY the facts
      // printed on the card itself (name, batch, photo, position), so
      // anyone scanning a card QR can confirm a genuine member without
      // the `users` collection being readable by guests (a `users`
      // query cannot be authorized for guests at all — the read rule
      // depends on fields a memberId lookup does not constrain).
      // A document exists exactly while the member is approved.
      allow read: if true;
      allow create, update: if isAdmin()
        || (signedIn() && me().memberId == memberId && me().status == 'approved');
      allow delete: if isAdmin()
        || (signedIn() && me().memberId == memberId);
    }
  }
}
